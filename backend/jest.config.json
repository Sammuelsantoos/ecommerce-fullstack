{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "src/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      { "useESM": true, "tsconfig": "<rootDir>/tsconfig.test.json" }
    ]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/generated/**",
    "!src/**/*.module.ts",
    "!src/**/dto/**"
  ],
  "coverageDirectory": "./coverage"
}
